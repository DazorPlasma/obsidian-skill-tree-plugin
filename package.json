{
  "name": "obsidian-skill-tree-plugin",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "wasm": "wasm-pack build --target web --release --out-dir plugin/pkg --out-name skill_tree_core",
    "build": "npm run wasm && tsc --noEmit && node esbuild.config.mjs",
    "dev": "npm run wasm && tsc --noEmit && node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test:adapter": "node --experimental-strip-types --test plugin/tests/cards.test.ts"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3"
  }
}
